  "fixed_sql": [
    {
      "name": "media_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"media_items\" (\"stable_key\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"volume_name\" TEXT NOT NULL, \"media_store_id\" INTEGER NOT NULL, \"content_uri\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"title\" TEXT NULL, \"mime_type\" TEXT NULL, \"size_bytes\" INTEGER NULL, \"date_added\" INTEGER NULL, \"date_modified\" INTEGER NULL, \"relative_path\" TEXT NULL, \"bucket_display_name\" TEXT NULL, \"width\" INTEGER NULL, \"height\" INTEGER NULL, \"duration_ms\" INTEGER NULL, \"artist\" TEXT NULL, \"album\" TEXT NULL, \"album_artist\" TEXT NULL, \"track_number\" INTEGER NULL, \"disc_number\" INTEGER NULL, \"genre\" TEXT NULL, \"screenshot_score\" INTEGER NULL, \"is_screenshot\" INTEGER NULL CHECK (\"is_screenshot\" IN (0, 1)), \"relink_signature\" TEXT NULL, \"first_discovered_at\" INTEGER NOT NULL, \"last_discovered_at\" INTEGER NOT NULL, \"last_indexed_generation\" INTEGER NULL, \"metadata_revision\" INTEGER NOT NULL, \"indexing_status\" TEXT NOT NULL, \"last_seen_access_scope\" TEXT NULL, \"searchable_text\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"stable_key\"));"
        }
      ]
    },
    {
      "name": "index_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"index_state\" (\"category\" TEXT NOT NULL, \"volume_name\" TEXT NOT NULL, \"last_generation\" INTEGER NULL, \"last_access_scope\" TEXT NOT NULL, \"last_sync_at\" INTEGER NOT NULL, \"last_result\" TEXT NOT NULL, PRIMARY KEY (\"category\", \"volume_name\"));"
        }
      ]
    },
    {
      "name": "ocr_content",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ocr_content\" (\"media_stable_key\" TEXT NOT NULL, \"raw_text\" TEXT NULL, \"normalized_text\" TEXT NULL, \"status\" TEXT NOT NULL, \"source_revision\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"error_code\" TEXT NULL, PRIMARY KEY (\"media_stable_key\"), FOREIGN KEY (media_stable_key) REFERENCES media_items (stable_key) ON DELETE CASCADE);"
        }
      ]
    },
